# Local development defaults. Staging and production read these from the secrets manager; the API refuses
# to start outside development/test while XV_JWT_SECRET is the development value.
XV_ENVIRONMENT=development
XV_DATABASE_URL=postgresql+psycopg://xplovoice_app:xplovoice_app@localhost:5432/xplovoice
XV_MIGRATION_DATABASE_URL=postgresql+psycopg://xplovoice_owner:xplovoice_owner@localhost:5432/xplovoice
XV_REDIS_URL=redis://localhost:6379/0
XV_JWT_SECRET=dev-only-change-me-dev-only-change-me
XV_ACCESS_TOKEN_MINUTES=15
XV_REFRESH_TOKEN_DAYS=30
XV_CORS_ORIGINS=["http://localhost:3000"]
XV_LOGIN_RATE_LIMIT_PER_MINUTE=10
